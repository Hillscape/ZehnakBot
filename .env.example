# توکن ربات رو از BotFather بگیر
TELEGRAM_BOT_TOKEN=your_bot_token_here

# آدرس webhook که تلگرام بهش پیام میفرسته
# مثال: https://yourusername.pythonanywhere.com/webhook
WEBHOOK_URL=https://yourusername.pythonanywhere.com/webhook

# کلید API انتروپیک برای مرحله بعدی (اتصال به Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# مسیر دیتابیس (فعلا SQLite، بعدا Postgres)
DATABASE_URL=sqlite:///bot.db
