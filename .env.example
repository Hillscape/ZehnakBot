# توکن ربات رو از BotFather بگیر (دستور /newbot)
TELEGRAM_BOT_TOKEN=******

# آدرس webhook که تلگرام بهش پیام میفرسته
# مثال: https://yourusername.pythonanywhere.com/webhook
WEBHOOK_URL=https://yourusername.pythonanywhere.com/webhook

# کلید API از aistudio.google.com/apikey (رایگان، بدون نیاز به کارت)
GEMINI_API_KEY=******

# مسیر دیتابیس (فعلا SQLite، بعدا میشه Postgres)
DATABASE_URL=sqlite:///bot.db
